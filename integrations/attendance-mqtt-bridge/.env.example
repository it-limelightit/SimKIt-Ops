# Run on the existing broker server, behind an HTTPS reverse proxy.
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=simkit-office-attendance
ATTENDANCE_DEVICE_ID=AYUE22065256
# Observed scan topic: spelling is stellar (two l characters).
ATTENDANCE_EVENT_TOPICS=aiface/AYUE22065256/sub/stellar
# Confirm command direction with firmware before setting this.
ATTENDANCE_COMMAND_TOPIC=
ATTENDANCE_DEVICE_TIME_OFFSET=+05:30
# Firmware meanings are unknown: explicitly confirm accepted face modes/entry flags.
ATTENDANCE_VALID_MODES=
ATTENDANCE_ENTRY_INOUT_VALUES=
# Exact record key for base64 JPEG/PNG; blank means no photo mapping yet.
ATTENDANCE_PHOTO_FIELD=
ATTENDANCE_PHOTO_MIME=image/jpeg
ATTENDANCE_DEVICE_WEBHOOK_URL=https://YOUR_PROJECT.supabase.co/functions/v1/attendance-device-event
ATTENDANCE_DEVICE_WEBHOOK_SECRET=
ATTENDANCE_PUBLISH_SECRET=
# Path to a real, vendor-confirmed enrollment JSON template. See setup guide.
ATTENDANCE_ENROLL_TEMPLATE_FILE=
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_DB=./bridge.sqlite
