[Unit]
Description=SimKit aiface attendance receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=simkit-attendance
Group=simkit-attendance
WorkingDirectory=/opt/simkit-attendance
EnvironmentFile=/etc/simkit-attendance.env
ExecStart=/usr/bin/node /opt/simkit-attendance/receiver.mjs
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/simkit-attendance

[Install]
WantedBy=multi-user.target
