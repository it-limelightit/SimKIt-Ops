# Private worker configuration. Never expose these through VITE_ variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Leave empty to obtain a short-lived read-only Google token from Supabase.
# The service-account private key can stay only in Supabase Secrets.
GOOGLE_APPLICATION_CREDENTIALS=
COMMISSIONING_REFERENCES_DIR=C:/private/simkit-certificate-references
# One parent folder for all companies. Optional when every company root is pinned in Supabase.
GOOGLE_DRIVE_COMPANIES_ROOT_ID=
# Optional: full executable paths when tools are not available on PATH.
FFPROBE_BIN=ffprobe
FFMPEG_BIN=ffmpeg
MAGICK_BIN=magick
TESSERACT_BIN=tesseract
PDFINFO_BIN=pdfinfo
PDFTOPPM_BIN=pdftoppm
